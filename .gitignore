# ============================================================
# KHÓA LUẬN - Web Platform .gitignore
# ============================================================

# ===== MODEL FILES (quá lớn, không push lên GitHub) =====
backend/models/*.keras
backend/models/*.h5
backend/models/*.pt
backend/models/*.pth
backend/models/*.pkl
backend/models/*.onnx

# ===== DATABASE (dữ liệu local, không share) =====
backend/lungcare.db
*.db
*.sqlite
*.sqlite3

# ===== UPLOADS (ảnh người dùng upload, dữ liệu nhạy cảm) =====
backend/uploads/*
# Giữ lại thư mục uploads (cần cho app chạy)
!backend/uploads/.gitkeep

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/
.env
.venv
venv/
env/
ENV/
pip-log.txt
pip-delete-this-directory.txt

# ===== NODE / FRONTEND =====
node_modules/
frontend/node_modules/
backend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
frontend/dist/
frontend/dist-ssr/

# ===== BENCHMARK RESULTS (generated files) =====
backend/benchmark_results.csv
backend/benchmark_http_results.csv

# ===== LOGS =====
*.log
debug.log
logs/

# ===== OS FILES =====
.DS_Store
Thumbs.db
desktop.ini

# ===== EDITOR =====
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ===== ZIP / BACKUP (quá lớn) =====
*.zip
*.rar
*.7z
codebackup/

# ===== WORD / PDF / TXT DRAFTS (tài liệu nội bộ) =====
*.docx
*.pdf
*.txt
toc_copy.docx
QA_KienTruc_HeThong.docx
Section_3_4_Web_App.docx
Section_3_4_Web_App_v2.docx
hướng dẫn xây webapp.docx
gradrollout.txt
newcode inference.txt
newcode scorecam.txt
simplified pneunet 3class_fix mixup mixcut.txt
simplified pneunet 4class_fix mixup mixcut.txt

# ===== SCRIPT TẠO TÀI LIỆU (không cần thiết) =====
gen_qa_word.py
gen_section34.py
gen_section34_v2.py
read_toc.py

# ===== ENV VARIABLES (QUAN TRỌNG - không push API keys) =====
.env
.env.local
.env.*.local
backend/.env
frontend/.env
